<Window x:Class="PWN_Simulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PWN_Simulator"
        xmlns:vm="clr-namespace:PWN_Simulator.ViewModel"
        mc:Ignorable="d"
        Title="PWN_Simulator" Height="745" Width="800">
    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel"/>
    </Window.DataContext>
    <StackPanel Margin="20">
        <TextBlock Text="股票代碼：" />
        <TextBox x:Name="TxtSymbol" Text="0050" Margin="0,5"/>

        <Button Content="查詢資產概況" Click="BtnRefresh_Click" Margin="0,10" Height="30"/>

        <Border BorderBrush="LightGray" BorderThickness="1" Padding="15" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="目前持有股數：" Foreground="Gray"/>
                <!-- 綁定到 Portfolio 物件的 CurrentHoldings 屬性 -->
                <TextBlock Text="{Binding Portfolio.CurrentHoldings}" FontSize="24" FontWeight="Bold"/>

                <TextBlock Text="目前總市值：" Margin="0,10,0,0" Foreground="Gray"/>
                <!-- 綁定到最新市值 -->
                <TextBlock Text="{Binding Portfolio.TotalMarketValue, StringFormat={}{0:C0}}" 
                           FontSize="32" Foreground="Green" FontWeight="Bold"/>

                <TextBlock Text="{Binding Portfolio.LastUpdated, StringFormat='最後更新：{0:yyyy/MM/dd HH:mm}'}" 
                           FontSize="10" Foreground="DimGray" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
        <GroupBox Header="AI Transaction Assistant" Margin="0,20,0,0">
            <StackPanel Margin="12">

                <TextBlock Text="請輸入交易內容："
                   FontWeight="Bold"
                   Margin="0,0,0,6"/>

                <TextBox Text="{Binding AIInputMessage, UpdateSourceTrigger=PropertyChanged}"
                 Height="80"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,10"/>

                <Button Content="AI 解析"
                Command="{Binding AskAICommand}"
                Width="120"
                Height="32"
                HorizontalAlignment="Left"
                Margin="0,0,0,10"/>

                <TextBlock Text="{Binding AIReply}"
                   TextWrapping="Wrap"
                   Foreground="DarkSlateBlue"
                   Margin="0,0,0,12"/>

                <Border BorderBrush="LightGray"
                BorderThickness="1"
                Padding="10"
                CornerRadius="5"
                Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ParsedResult.Action}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Symbol:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParsedResult.Symbol}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Quantity:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ParsedResult.Quantity}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Price:" FontWeight="Bold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ParsedResult.Price}"/>
                    </Grid>
                </Border>

                <Button Content="Confirm Save"
                Command="{Binding ConfirmTransactionCommand}"
                IsEnabled="{Binding CanConfirmTransaction}"
                Width="140"
                Height="32"
                HorizontalAlignment="Left"/>

            </StackPanel>
        </GroupBox>
    </StackPanel>
</Window>
